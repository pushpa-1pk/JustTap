# JustTap Mobile Environment Configuration Example
# When running on a physical device, point service URLs to your computer's LAN IP (e.g. 192.168.x.x) instead of localhost.

EXPO_PUBLIC_ENV=development

EXPO_PUBLIC_AUTH_SERVICE_URL=http://localhost:4000
EXPO_PUBLIC_PROFILE_SERVICE_URL=http://localhost:4001
EXPO_PUBLIC_SERVICE_MANAGEMENT_URL=http://localhost:4002
EXPO_PUBLIC_BOOKING_SERVICE_URL=http://localhost:3001
EXPO_PUBLIC_MATCHING_SERVICE_URL=http://localhost:5003
EXPO_PUBLIC_NOTIFICATION_SERVICE_URL=http://localhost:4005
EXPO_PUBLIC_PAYMENT_SERVICE_URL=http://localhost:5005
EXPO_PUBLIC_REVIEW_SERVICE_URL=http://localhost:5006
EXPO_PUBLIC_TRACKING_SERVICE_URL=http://localhost:5004

# Cloudinary Upload Configuration
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
EXPO_PUBLIC_CLOUDINARY_API_KEY=your_cloudinary_api_key
EXPO_PUBLIC_CLOUDINARY_API_SECRET=your_cloudinary_api_secret
EXPO_PUBLIC_CLOUDINARY_FOLDER=justtap/profile-images/customers
