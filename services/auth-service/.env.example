NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/justtap_auth
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
JWT_ISSUER=justtap-auth
JWT_AUDIENCE=justtap-clients
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d
JSON_BODY_LIMIT=100kb
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SEND_OTP_RATE_LIMIT_WINDOW_MS=900000
SEND_OTP_RATE_LIMIT_MAX=5
VERIFY_OTP_RATE_LIMIT_WINDOW_MS=900000
VERIFY_OTP_RATE_LIMIT_MAX=10
REFRESH_TOKEN_RATE_LIMIT_WINDOW_MS=900000
REFRESH_TOKEN_RATE_LIMIT_MAX=30
SMS_PROVIDER=mock
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4
MSG91_COUNTRY=91
MSG91_DLT_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
LOG_LEVEL=info
