# ==============================================================================
# AUTH SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_auth

# Cache & Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here

# JWT Token Expiration
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Rate Limiting Settings
SEND_OTP_RATE_LIMIT_WINDOW_MS=60000
SEND_OTP_RATE_LIMIT_MAX=3
VERIFY_OTP_RATE_LIMIT_WINDOW_MS=60000
VERIFY_OTP_RATE_LIMIT_MAX=5
REFRESH_TOKEN_RATE_LIMIT_WINDOW_MS=60000
REFRESH_TOKEN_RATE_LIMIT_MAX=10

# Third-Party Messaging Services (SMS/OTP)
TWILIO_ACCOUNT_SID=AC_dummy_account_sid
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_FROM_NUMBER=+1234567890
MSG91_AUTH_KEY=dummy_msg91_key
MSG91_DLT_TEMPLATE_ID=dummy_template_id
