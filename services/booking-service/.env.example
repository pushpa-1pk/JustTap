NODE_ENV=development
PORT=5000
SERVICE_NAME=booking-service
MONGO_URI=mongodb://127.0.0.1:27017/justtap_booking
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_REFRESH_SECRET=replace-with-a-strong-refresh-secret
AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_USER_LOOKUP_REQUIRED=true
AUTH_USER_LOOKUP_TIMEOUT_MS=3000
INTERNAL_API_KEY=justtap-internal-dev-key
PROFILE_SERVICE_URL=http://127.0.0.1:4001
PROFILE_LOOKUP_REQUIRED=true
PROFILE_LOOKUP_TIMEOUT_MS=3000
SERVICE_MANAGEMENT_SERVICE_URL=http://127.0.0.1:4002
SERVICE_LOOKUP_REQUIRED=true
SERVICE_LOOKUP_TIMEOUT_MS=3000
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info
TRAVEL_RATE_PER_KM=15
FREE_DISTANCE_KM=2
PLATFORM_COMMISSION_PERCENT=15
GST_PERCENT=18
PROVIDER_ACCEPT_TIMEOUT_MS=60000
OTP_EXPIRY_MS=300000
DISPUTE_WINDOW_MAX_HOURS=24
CUSTOMER_CANCELLATION_AFTER_ACCEPT=50
PROVIDER_CANCELLATION_ON_THE_WAY=100
