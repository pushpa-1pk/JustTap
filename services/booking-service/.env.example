# ==============================================================================
# BOOKING SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_booking

# Cache & Redis Configuration
REDIS_URL=redis://127.0.0.1:6379

# Event Bus / RabbitMQ Configuration
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here

# Dependent Microservices URLs
AUTH_SERVICE_URL=http://127.0.0.1:4000
PROFILE_SERVICE_URL=http://127.0.0.1:4001
SERVICE_MANAGEMENT_SERVICE_URL=http://127.0.0.1:4002
MATCHING_SERVICE_URL=http://127.0.0.1:5003
PAYMENT_SERVICE_URL=http://127.0.0.1:5005
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
