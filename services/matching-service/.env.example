NODE_ENV=development
PORT=5003
SERVICE_NAME=matching-service
MONGO_URI=mongodb://127.0.0.1:27017/justtap_matching
REDIS_URL=redis://127.0.0.1:6379
REDIS_DB=0
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=100kb
LOG_LEVEL=info
AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_USER_LOOKUP_REQUIRED=true
AUTH_USER_LOOKUP_TIMEOUT_MS=3000
PROFILE_SERVICE_URL=http://127.0.0.1:4001
SERVICE_MANAGEMENT_SERVICE_URL=http://127.0.0.1:4002
BOOKING_SERVICE_URL=http://127.0.0.1:5000
CLIENT_TIMEOUT_MS=3000
CLIENT_MAX_SOCKETS=100
MAX_HTTP_KEEP_ALIVE_MSEC=60000
INTERNAL_API_KEY=justtap-internal-dev-key
MAX_SEARCH_RADIUS_KM=25
DEFAULT_SEARCH_RADIUS_KM=10
DEFAULT_SEARCH_LIMIT=20
PROVIDER_TIMEOUT_SECONDS=60
STALE_LOCATION_THRESHOLD_MINUTES=5
PRESENCE_TTL_SECONDS=180
BOOKING_REQUEST_TTL_SECONDS=60
TIMEOUT_WORKER_POLL_INTERVAL_MS=2000
TIMEOUT_WORKER_BATCH_SIZE=50
SEARCH_RATE_LIMIT_WINDOW_MS=60000
SEARCH_RATE_LIMIT_MAX=30
LOCATION_RATE_LIMIT_WINDOW_MS=60000
LOCATION_RATE_LIMIT_MAX=30
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MSEC=30000
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=45000
