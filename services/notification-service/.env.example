# ==============================================================================
# NOTIFICATION SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4005

# Database & Cache Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_notification
REDIS_URI=redis://127.0.0.1:6379

# Event Bus / RabbitMQ Configuration
RABBITMQ_URI=amqp://127.0.0.1:5672

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_SECRET=your_jwt_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here

# SMTP Email Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=dummy_smtp_user
SMTP_PASS=dummy_smtp_password
SMTP_FROM_EMAIL=noreply@justtap.in

# SMS & Push Notification Gateway Credentials
TWILIO_ACCOUNT_SID=AC_dummy_account_sid
TWILIO_AUTH_TOKEN=dummy_auth_token
TWILIO_FROM_PHONE=+1234567890
FCM_SERVER_KEY=dummy_fcm_server_key
