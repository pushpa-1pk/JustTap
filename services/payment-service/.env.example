NODE_ENV=development
PORT=5005
SERVICE_NAME=payment-service
MONGO_URI=mongodb://127.0.0.1:27017/justtap_payment
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_ISSUER=justtap-auth
JWT_AUDIENCE=justtap-clients
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret
BOOKING_SERVICE_URL=http://127.0.0.1:5000
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events
INTERNAL_API_KEY=justtap-internal-dev-key
BANK_ENCRYPTION_SECRET=replace-with-a-strong-bank-encryption-secret
PLATFORM_COMMISSION_PERCENT=10
GST_PERCENT_ON_COMMISSION=18
SETTLEMENT_HOLD_HOURS=24
OUTBOX_BATCH_SIZE=20
OUTBOX_LOOP_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=5
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
