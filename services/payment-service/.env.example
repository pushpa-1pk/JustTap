# ==============================================================================
# PAYMENT SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4004
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Database & Cache Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_payment
REDIS_URL=redis://127.0.0.1:6379

# Event Bus / RabbitMQ Configuration
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here
BANK_ENCRYPTION_SECRET=your_bank_encryption_secret_min_32_chars

# Payment Gateway Credentials (Razorpay / Stripe)
RAZORPAY_KEY_ID=rzp_test_dummy_key_id
RAZORPAY_KEY_SECRET=dummy_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=dummy_webhook_secret

# Dependent Microservices URLs
BOOKING_SERVICE_URL=http://127.0.0.1:3001
PROFILE_SERVICE_URL=http://127.0.0.1:4001
NOTIFICATION_SERVICE_URL=http://127.0.0.1:4005
