NODE_ENV=development
PORT=4001

# MongoDB for profile-service
MONGO_URI=mongodb://127.0.0.1:27017/justtap_profile

# Must match auth-service access token signing secret
JWT_ACCESS_SECRET=e6fff89a2313849544b7a4ebee5708093448ee19b322fb448fc556ef12d6ef7c

# Used when profile-service calls auth-service /api/v1/auth/me
AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_USER_LOOKUP_REQUIRED=true
AUTH_USER_LOOKUP_TIMEOUT_MS=3000
INTERNAL_API_KEY=justtap-internal-dev-key
PUBLIC_BASE_URL=http://127.0.0.1:4001

# CSV list. Leave empty in local development to allow all origins.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JSON_BODY_LIMIT=100kb
LOG_LEVEL=info
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
PROVIDER_RATE_LIMIT_WINDOW_MS=900000
PROVIDER_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=60

STORAGE_DRIVER=local
UPLOADS_DIR_NAME=uploads
PROFILE_IMAGE_MAX_FILE_SIZE_MB=5
DOCUMENT_MAX_FILE_SIZE_MB=10

# Required only when STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=justtap
ALLOW_REMOTE_FILE_URL_UPLOADS=false

# 32+ chars recommended
BANK_ENCRYPTION_SECRET=e6fff89a2313849544b7a4ebee5708093448ee19b322fb448fc556ef12d6ef7c
