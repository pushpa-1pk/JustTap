# ==============================================================================
# PROFILE SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4001
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_profile

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here
BANK_ENCRYPTION_SECRET=your_bank_encryption_secret_min_32_chars

# Cloudinary Credentials (For Profile/Document Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Dependent Microservices URLs
AUTH_SERVICE_URL=http://127.0.0.1:4000
