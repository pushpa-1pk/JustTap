NODE_ENV=development
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/justtap_profile
JWT_ACCESS_SECRET=replace-with-your-auth-access-secret
AUTH_SERVICE_URL=http://127.0.0.1:4000
AUTH_USER_LOOKUP_REQUIRED=true
AUTH_USER_LOOKUP_TIMEOUT_MS=3000
PUBLIC_BASE_URL=http://127.0.0.1:4001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JSON_BODY_LIMIT=100kb
LOG_LEVEL=info
GENERAL_RATE_LIMIT_WINDOW_MS=900000
GENERAL_RATE_LIMIT_MAX=300
PROVIDER_RATE_LIMIT_WINDOW_MS=900000
PROVIDER_RATE_LIMIT_MAX=120
ADMIN_RATE_LIMIT_WINDOW_MS=900000
ADMIN_RATE_LIMIT_MAX=60
STORAGE_DRIVER=local
UPLOADS_DIR_NAME=uploads
PROFILE_IMAGE_MAX_FILE_SIZE_MB=5
DOCUMENT_MAX_FILE_SIZE_MB=10
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_PREFIX=justtap
ALLOW_REMOTE_FILE_URL_UPLOADS=false
BANK_ENCRYPTION_SECRET=replace-with-a-strong-bank-encryption-secret
