# ==============================================================================
# SERVICE MANAGEMENT SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_service_catalog

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here

# Dependent Microservices URLs
AUTH_SERVICE_URL=http://127.0.0.1:4000
PROFILE_SERVICE_URL=http://127.0.0.1:4001
