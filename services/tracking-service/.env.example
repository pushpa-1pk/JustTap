NODE_ENV=development
PORT=5004
SERVICE_NAME=tracking-service
MONGO_URI=mongodb://127.0.0.1:27017/justtap_tracking
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-strong-access-secret
JWT_ISSUER=justtap-auth
JWT_AUDIENCE=justtap-clients
BOOKING_SERVICE_URL=http://127.0.0.1:5000
INTERNAL_API_KEY=justtap-internal-dev-key
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_ACCURACY_THRESHOLD_METERS=50
TELEMETRY_THROTTLE_WINDOW_MS=2000
GEOFENCE_NEARBY=500
GEOFENCE_ARRIVED=100
TRACKING_STREAM_NAME=mystream:tracking:events
BOOKING_CONSUMER_GROUP=group:tracking:booking-sync
