# ==============================================================================
# TRACKING SERVICE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Configuration
NODE_ENV=development
PORT=4006
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3002

# Database & Cache Configuration
MONGO_URI=mongodb://127.0.0.1:27017/justtap_tracking
REDIS_URL=redis://127.0.0.1:6379

# Event Bus / RabbitMQ Configuration
RABBITMQ_URI=amqp://127.0.0.1:5672
RABBITMQ_EXCHANGE=justtap.events

# Security & Secrets (STRICTLY REQUIRED - Fail-fast on startup if missing)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long_12345
INTERNAL_API_KEY=your_internal_api_key_min_16_chars_here
JWT_ISSUER=justtap-auth-service
JWT_AUDIENCE=justtap-platform-users

# Dependent Microservices URLs
MATCHING_SERVICE_URL=http://127.0.0.1:4003
BOOKING_SERVICE_URL=http://127.0.0.1:3001
